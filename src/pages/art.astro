---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery';

// Curated display order
const files = [
  'IMG_7100.jpg',
  'IMG_1638.jpg',
  'IMG_7597.jpg',
  'IMG_4334.jpg',
  '8bd3c13d7a58d252abc32cd661e72a34fd9a2310.jpg',
  'd1a9501d12172d44c52d4e839d1a68c49a5312e2.jpg',
  '63fce0fd212f5d6d9b48980544919ef734f3d17c.jpg',
  '26058bfd0b4200e2a1200a922253bd933417c5.jpeg',
  'd1b352bdbe683b12949b725124d38353345aac.jpeg',
  'c5fc1fe39366f78ba207e614b6607ee04b3a9056.png',
  'artwork-11.webp',
];

const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/art/*', { eager: true });

// Build-time optimization: small WebP thumbnails for the grid, a capped
// larger WebP for the lightbox. Originals never ship to the browser.
const artworks = await Promise.all(
  files.map(async (file) => {
    const src = modules[`../assets/art/${file}`].default;
    const thumb = await getImage({ src, width: 700, format: 'webp', quality: 80 });
    const full = await getImage({
      src,
      width: Math.min(1600, src.width),
      format: 'webp',
      quality: 85,
    });
    return {
      thumb: thumb.src,
      full: full.src,
      width: src.width,
      height: src.height,
      alt: 'Artwork by Subha Vadlamannati',
    };
  }),
);
---

<Base title="Art - Subha Vadlamannati">
  <h1 class="text-2xl font-semibold tracking-tight">Art</h1>
  <p class="mt-2 text-soft">A collection of my artwork.</p>

  <div class="mt-8">
    <Gallery images={artworks} client:load />
  </div>
</Base>
