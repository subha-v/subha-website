---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base title="Blog - Subha Vadlamannati">
  <h1 class="text-2xl font-semibold tracking-tight">Blog</h1>

  <ul class="mt-10 space-y-10">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <span class="font-medium text-ink transition-colors group-hover:text-sakura">
                {post.data.title}
              </span>
              <time
                datetime={post.data.date.toISOString()}
                class="shrink-0 text-xs text-faint sm:ml-6"
              >
                {formatDate(post.data.date)}
              </time>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-soft">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
