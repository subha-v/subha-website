---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc';
import SleepingCat from '../../components/pixel/SleepingCat.astro';
import Sparkles from '../../components/pixel/Sparkles.astro';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${post.data.title} - Subha Vadlamannati`} description={post.data.description}>
  {
    tocHeadings.length > 0 && (
      <div class="pointer-events-none fixed inset-x-0 top-32 z-10 hidden xl:block">
        <div class="relative mx-auto w-full max-w-2xl px-6">
          <div class="pointer-events-auto absolute top-0 right-[calc(100%+1.5rem)] w-52">
            <Toc headings={tocHeadings} client:load />
          </div>
        </div>
      </div>
    )
  }

  <article class="pt-4">
    <header>
      <h1 class="text-2xl font-semibold tracking-tight">{post.data.title}</h1>
      <p class="mt-3 leading-relaxed text-soft">{post.data.description}</p>
      <time datetime={post.data.date.toISOString()} class="mt-4 block text-xs text-faint">
        {formattedDate}
      </time>
    </header>

    <div class="prose mt-12">
      <Content />
    </div>

    <div class="mt-20 flex flex-col items-center">
      <Sparkles />
      <SleepingCat class="mt-8" />
      <span class="font-pixel mt-3 text-[10px] lowercase text-faint select-none">fin</span>
    </div>
  </article>
</Base>
