---
import Base from '../layouts/Base.astro';
import SittingCat from '../components/pixel/SittingCat.astro';
---

<Base title="404 - Subha Vadlamannati">
  <div class="flex flex-col items-center py-20 text-center">
    <SittingCat class="h-24 w-auto" />
    <h1 class="font-pixel mt-8 text-3xl text-ink">404</h1>
    <p class="mt-3 text-soft">This page hopped away.</p>
    <a
      href="/"
      class="mt-6 text-sm text-sakura underline decoration-sakura-bright/40 underline-offset-4 transition-colors hover:decoration-sakura-bright"
    >
      Back home
    </a>
  </div>
</Base>
